# Proyecto e imágenes (defaults = Docker Hub del proyecto; sobreescribibles)
PROJECT=semana-torneo
BACKEND_IMAGE=nachoalbarracin/semana-torneo-backend:latest
FRONTEND_IMAGE=nachoalbarracin/semana-torneo-frontend:latest

# Token del túnel (Cloudflare Zero Trust → Networks → Tunnels → tu túnel → Configure)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Laravel (producción) ---
APP_NAME="Semana Torneo"
APP_ENV=production
APP_DEBUG=false
# Generar con: php artisan key:generate --show (dentro de semana-ingenieria-app-back)
APP_KEY=
# URL pública de la API (sin /api al final)
APP_URL=https://api.tu-dominio.com

# sqlite persiste en ./data/database.sqlite vía bind mount (ver compose de servidor)
DB_CONNECTION=sqlite

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Solo build local (se hornean en la imagen frontend como --build-arg) ---
# Debe terminar en /api (las rutas del back viven bajo ese prefijo)
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com/api
NEXT_PUBLIC_CLAVE_ADMIN=
